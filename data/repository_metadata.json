  "inclusion_criteria": [
    "Entry has a Materials Project identifier stored as mpid.",
    "Entry is present as a completed ASE database row in data/h.db.",
    "Entry has status=completed, calc_status=done, and jtype=scf.",
    "Entry contains an atomic structure readable by ASE, including chemical symbols, positions, and cell information.",
    "Entry contains all four required Hirshfeld-related arrays: hirshfeld, hirshfeld_i, hirshfeld_relvol, and hirshfeld_i_relvol.",
    "Each Hirshfeld-related array has a length equal to the number of atomic sites in the structure.",
    "The material has between 1 and 11 atomic sites in the archived database entry."
  ],
  "exclusion_criteria": [
    "Entries without a Materials Project identifier were not included.",
    "Entries without completed SCF status were not included.",
    "Entries missing any of the four Hirshfeld-related arrays were not included.",
